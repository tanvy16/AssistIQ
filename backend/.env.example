APP_ENV=development

# Neon PostgreSQL — asyncpg driver, SSL required
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# CORS (Vite dev server — use 127.0.0.1 consistently, not localhost)
CORS_ORIGINS=["http://127.0.0.1:5173"]

# JWT (generate a random 32+ character secret; never commit real values)
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Cookie security. Must be true when APP_ENV=production (HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate limiting (in-memory, single-instance)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=30
RATE_LIMIT_REFRESH_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=40
RATE_LIMIT_IT_PER_MINUTE=20
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=15

# Seed users (development only — set real values in backend/.env, never commit)
# SEED_EMPLOYEE_EMAIL=
# SEED_EMPLOYEE_PASSWORD=
# SEED_AGENT_EMAIL=
# SEED_AGENT_PASSWORD=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

CHROMA_PERSIST_DIR=./data/chroma
# LLM_API_KEY=
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# For local Ollama, use: LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_DEFAULT_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=180
